# Profile: agents — 10 distributed k6 agents, 100 rotating synthetic users.
#
# Ten parallel k6 agent Pods share the load. Every request carries a freshly
# self-signed subject token (RS256, key from keys/subject-signing.key) whose
# `sub` rotates through 100 synthetic usernames, so no token is replayed and
# no user store is needed — PingFederate validates the signature against the
# JWKS published via the server profile. The measured path is exactly the
# production one: client-credentials authentication + token exchange.
#
# Usage:
#   make validate
#   make keys                   # once; then push server-profiles/ and make deploy
#   make test PROFILE=agents

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
RATE=500
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=25
MAX_VUS=100
P95_MS=500
SUCCESS_RATE=0.99
INSECURE_SKIP_TLS_VERIFY=true

# --- Test client (client credentials, measured on every request) ------
CLIENT_ID=perf-test-client
# CLIENT_SECRET comes from .env (profiles never hold secrets). Setting it
# to empty here would clobber the .env value, so it is commented out.
# CLIENT_SECRET=
CLIENT_AUTH_METHOD=client_secret_basic
REQUESTED_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token

# --- Subject tokens (self-signed by k6, validated via profile JWKS) ----
SUBJECT_ISSUER=https://pf-perf-subject
SUBJECT_AUDIENCE=perf-test-client
SUBJECT_USER_COUNT=100

# Optional RFC 8693 parameters. RESOURCE selects the access token manager
# (RFC 8707) and - via the mapping's OGNL - becomes the token's aud claim;
# it must match the ATM's configured resource URIs or PF rejects the request
# with invalid_target. SCOPE must be registered in the OAuth server settings.
# The act claim's sub is the client id - no actor_token is sent.
RESOURCE=https://mcp.example.internal/mcp
AUDIENCE=
SCOPE=mcp:tools:invoke
