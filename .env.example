# Kubernetes and Helm
NAMESPACE=pf-perf
PF_RELEASE=pf
PING_CHART_VERSION=0.15.0

# Ping DevOps evaluation licensing (do not commit .env)
PING_IDENTITY_DEVOPS_USER=
PING_IDENTITY_DEVOPS_KEY=
PING_IDENTITY_ACCEPT_EULA=YES

# A git repository containing this project's server-profiles/ content.
# SERVER_PROFILE_PATH is the folder inside that repo holding the profile
# (the directory that contains instance/ and hooks/).
SERVER_PROFILE_URL=https://github.com/your-org/your-ping-server-profiles.git
SERVER_PROFILE_PATH=pingfederate-token-exchange
SERVER_PROFILE_BRANCH=main

# Subject-token signing key (private, generated by `make keys`) whose public
# JWKS ships in the server profile and is validated by PingFederate.
SUBJECT_SIGNING_KEY_FILE=${ROOT_DIR}/keys/subject-signing.key

# Token exchange request. This in-cluster URL targets the two engine Pods.
PF_TOKEN_URL=https://pf-pingfederate-engine:9031/as/token.oauth2
CLIENT_ID=perf-test-client
CLIENT_SECRET=
# Secret for the client the profile's bulk import creates. Must equal
# CLIENT_SECRET above.
PERF_CLIENT_SECRET=
CLIENT_AUTH_METHOD=client_secret_basic
SUBJECT_ISSUER=https://pf-perf-subject
SUBJECT_AUDIENCE=perf-test-client
SUBJECT_USER_COUNT=100
SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token
REQUESTED_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token

# Optional RFC 8693 parameters. Leave blank when unused.
RESOURCE=
AUDIENCE=
SCOPE=
ACTOR_TOKEN=
ACTOR_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token

# k6 load shape and pass/fail thresholds.
RATE=50
DURATION=5m
PRE_ALLOCATED_VUS=25
MAX_VUS=200
P95_MS=500
SUCCESS_RATE=0.99
INSECURE_SKIP_TLS_VERIFY=true

# Optional load profile: PROFILE=agents loads profiles/agents.env on top of
# this file. See README.md ("Load profiles"). Values in the profile win.
# PROFILE=agents

# --- SSL server keypair (lab TLS for the PF pods) --------------------------
# The p12 (git-ignored, holds a private key) and its password. Generate a new
# pair whenever you set up a fresh lab:
#   openssl req -x509 -newkey rsa:2048 -keyout ssl.key -out ssl.crt -days 3650 \
#     -nodes -subj "/CN=pf-pingfederate"
#   openssl pkcs12 -export -inkey ssl.key -in ssl.crt \
#     -out server-profiles/pingfederate-token-exchange/ssl-server.p12 \
#     -name sslservercert -password pass:<your-password>
PERF_SSL_SERVER_P12_PASSWORD=
PERF_SSL_SERVER_P12_FILE=${ROOT_DIR}/server-profiles/pingfederate-token-exchange/ssl-server.p12
